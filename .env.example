# --- Local CLI / Cursor (SQLite file). Do not use this on Vercel. ---
DATABASE_URL="file:./dev.db"

# --- Hosted preview (Vercel). Required: Postgres from Neon or Supabase. ---
# Use the DIRECT / non-pooled URI so `prisma db push` works at build time.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required everywhere (session cookies). Any long random string is fine for demo.
AUTH_SECRET="replace-with-a-long-random-string"

# Owner hub. When this is set, OWNER_ACCESS_CODE is ignored. Do not commit a real value.
# OWNER_HUB_CODE=""
# Fallback only while OWNER_HUB_CODE is unset.
# OWNER_ACCESS_CODE=""

# Staff entry. Opens Program Lead, Director, Dispatch, and Driver. Never the owner hub.
# STAFF_MASTER_CODE=""

# After an owner or staff session exists, this can stand in for that day's desk code.
# It does not sign anyone in by itself.
# MASTER_DAY_CODE=""

# Quote and contact notifications. Mail is skipped until RESEND_API_KEY is set; the request still saves.
# QUOTE_NOTIFY_EMAIL="venturedirectors@gmail.com"
# QUOTE_FROM_EMAIL="Venture Directors <onboarding@resend.dev>"
# RESEND_API_KEY=""

# Public site. Texts and canonical links use this. Defaults to the live domain when unset.
NEXT_PUBLIC_APP_URL="https://www.venturedirectors.com"
NEXT_PUBLIC_APP_NAME="Venture Directors"
PROVIDER_MODE="mock"

# Optional. When set, quote address suggestions use Google Places and fall back to the local Orlando list.
# GOOGLE_PLACES_API_KEY=""

# Optional drive-time lookups for shuttle-loop sizing. Either key is enough. Unset keys fall back to the admin drive-minutes table.
# GOOGLE_MAPS_API_KEY=""
# MAPBOX_ACCESS_TOKEN=""

# Set to 1 on Vercel if you ever want to skip re-seeding on each deploy.
# SKIP_DEMO_SEED="1"

# Flight status. With neither key set, the arrivals board stays in manual mode.
# AERODATABOX_API_KEY=""
# AERODATABOX_HOST="aerodatabox.p.rapidapi.com"
# FLIGHTAWARE_API_KEY=""

# SMS. Telnyx is used first. Twilio is used only when Telnyx is unset.
# TELNYX_API_KEY=""
# TELNYX_FROM_NUMBER=""
# TELNYX_MESSAGING_PROFILE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Optional. Rewrites messy staff texts. Rules still run when this is unset.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

