# --- Local CLI / Cursor (SQLite file). Do not use this on Vercel. ---
DATABASE_URL="file:./dev.db"

# --- Hosted preview (Vercel). Required: Postgres from Neon or Supabase. ---
# Use the DIRECT / non-pooled URI so `prisma db push` works at build time.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required everywhere (session cookies). Any long random string is fine for demo.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional
NEXT_PUBLIC_APP_NAME="Venture Directors"
PROVIDER_MODE="mock"

# Set to 1 on Vercel if you ever want to skip re-seeding on each deploy.
# SKIP_DEMO_SEED="1"
