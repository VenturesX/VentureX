{
  "name": "venture-directors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43127",
    "predev": "tsx prisma/ensure.ts",
    "build": "node scripts/prisma-adapt.mjs && prisma generate && (prisma db push --accept-data-loss --skip-generate || node -e \"console.warn('warn: prisma db push failed; continuing to next build')\") && (node scripts/maybe-seed.mjs || node -e \"console.warn('warn: database seed failed; continuing to next build')\") && next build",
    "start": "next start -p 43127",
    "lint": "eslint",
    "test": "tsx --env-file=.env --test src/lib/guest-access.test.ts src/lib/guest-counts.test.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "6.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "prisma": "6.16.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
